# Supabase Transaction Pooler connection string (port 6543). Keep server-side.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require

# Google AI Studio key. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# The app reads live columns from information_schema in Phase 2.
DB_SCHEMA=public

# Safety cap applied by the SQL execution layer in a later phase.
QUERY_MAX_ROWS=500

# Set false only for the local demo if Node cannot verify the database certificate.
DB_SSL_VERIFY=true
